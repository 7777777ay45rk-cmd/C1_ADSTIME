# ADSTIME - clean URL routing
# WHY: this whole file just makes "/pricing" serve "pricing.php" without ever showing
# ".php" in the address bar. There's no RewriteBase set on purpose, so this works the same
# at the domain root or inside a subfolder used for local testing (matching how BASE_PATH
# works in includes/config.php) - but that means every rule that redirects the browser
# (the [R] flag) has to build its target from %{THE_REQUEST} into an absolute "/..." path
# rather than a plain relative filename. A relative redirect target needs RewriteBase to be
# set correctly, and without it Apache's guess can build the wrong URL inside a subfolder.
# Rules that only rewrite internally (no [R], no flag visible to the browser) don't have
# this problem and can stay relative.

RewriteEngine On

DirectoryIndex index.php

Options -Indexes
ServerSignature Off

# SEO-NOTE: force a single canonical host (https://www.adstime.in) so search engines never see
# the same page under http/https and with/without "www" as separate URLs. This must run before
# every other rule below, and only actually redirects on a live server - on shared hosting
# without HTTPS configured yet, comment out the "HTTPS off" line until SSL is active.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$
RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

# sitemap.xml is generated by sitemap.php but must stay extension-less in the URL
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# WHY: without this, a direct request for sitemap.php would fall through to the generic
# ".php" redirect below and land on a bare "/sitemap" URL instead of the real "/sitemap.xml".
# WHY %{THE_REQUEST} instead of matching the URI directly: the rule above internally rewrites
# sitemap.xml -> sitemap.php, which re-enters this whole file from the top. Matching the URI
# would catch that internal rewrite too and bounce it right back out as a redirect loop.
# THE_REQUEST always holds the browser's original request line, so this only fires for a real
# direct hit on sitemap.php. Building the target from %1 (an absolute path, starts with "/")
# instead of a bare "sitemap.xml" also sidesteps a classic mod_rewrite trap: a *relative*
# substitution combined with [R] needs an explicit RewriteBase to build the right redirect
# inside a subfolder, or it wrongly redirects to the *filesystem* path instead of the URL path.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s(/(?:.*/)?)sitemap(?:\.php)?[\s?] [NC]
RewriteRule ^ %1sitemap.xml [R=301,L]

# SEO-NOTE: 301 redirects for URLs that used to be real pages before the services/ restructure
# (services.php -> our-services.php, and seo.php / web-development.php moved into /services/).
# These preserve any search ranking / bookmarks / inbound links pointing at the old URLs instead
# of just letting them 404. Add a line here any time a live URL moves again in the future.
# WHY the target is a hardcoded "/..." path (unlike the other [R] rules in this file, which build
# their target from %{THE_REQUEST}): these three always point at the same new URL no matter what
# was requested, so there's nothing to capture from the request itself. That does mean these three
# assume the site lives at the domain root, same caveat as the ErrorDocument line further down -
# fine for production, but a local subfolder test won't redirect to the right place for these.
RewriteRule ^services/?$ /our-services [R=301,L]
RewriteRule ^seo/?$ /services/seo [R=301,L]
RewriteRule ^web-development/?$ /services/web-development [R=301,L]

# SEO-NOTE: send /index and /index.php to the real homepage URL so there's only one
# URL for the homepage instead of three separate copies of the same content.
# WHY %{THE_REQUEST} here too: same reasoning as the sitemap rule above - it's the only way
# to build an absolute, subfolder-safe redirect target without hardcoding RewriteBase.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s(/(?:.*/)?)index(?:\.php)?[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# SEO-NOTE: if someone requests /page.php directly (or an old bookmark/link does),
# 301 redirect to the clean /page URL so there's only ever one canonical URL per page.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s([^.]+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Serve the matching .php file for a clean URL (covers root pages and /blog/post-slug alike)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# SEO-NOTE: ErrorDocument paths are always resolved from the domain root, unlike the
# RewriteRules above, so this line assumes the site lives at the domain root (adstime.in/).
# If you're testing inside a local subfolder, change this to "/your-subfolder/404" or
# comment it out - it doesn't affect anything else on the site either way.
ErrorDocument 404 /404

# Basic caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  # WHY a full year for fonts specifically: these font files are self-hosted now (see
  # assets/fonts/) and only ever change if someone swaps the actual file - a returning
  # visitor's browser should never have to re-request them.
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>
